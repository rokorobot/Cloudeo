from __future__ import annotations

import json
import uuid

from cloudeo.adapters.jev import JevClient, JevError
from cloudeo.adapters.treg import TregClient, TregError
from cloudeo.config import Settings
from cloudeo.db.models import RunRecord
from cloudeo.db.session import Database
from cloudeo.models import AttemptResult, RunRequest, RunResponse


class Controller:
    def __init__(
        self,
        settings: Settings,
        jev: JevClient,
        treg: TregClient,
        database: Database,
    ):
        self.settings = settings
        self.jev = jev
        self.treg = treg
        self.database = database

    async def run(self, request: RunRequest) -> RunResponse:
        run_id = str(uuid.uuid4())
        route_threshold = request.route_confidence or self.settings.route_confidence
        verify_threshold = request.verify_probability or self.settings.verify_probability
        max_attempts = request.max_attempts or self.settings.max_attempts

        criteria = {
            candidate.id: (
                f"Use Treg tool {candidate.treg_tool_id}. {candidate.description}. "
                f"Method: {candidate.method}. Query parameters: {candidate.query}. "
                f"JSON body: {candidate.body}"
            )
            for candidate in request.candidates
        }
        criteria["escalate"] = (
            "None of the candidate tools is appropriate or there is not enough information to choose safely."
        )

        routing_state = {
            "objective": request.objective,
            "state": request.state,
            "success_criteria": request.success_criteria,
        }
        route = await self.jev.decide(
            routing_state,
            {
                "tool_route": {
                    "type": "choice",
                    "instructions": (
                        "Choose the single best next tool for the objective. Prefer a tool that can "
                        "directly satisfy the objective with the supplied state. Choose escalate if none fit."
                    ),
                    "criteria": criteria,
                }
            },
        )
        route_answer = route["answers"]["tool_route"]
        probabilities = {
            str(k): float(v) for k, v in (route_answer.get("probabilities") or {}).items()
        }
        choice = str(route_answer.get("choice", "escalate"))
        confidence = float(route_answer.get("confidence") or 0.0)

        if choice == "escalate" or confidence < route_threshold:
            response = RunResponse(
                run_id=run_id,
                status="escalate",
                selected_tool=None,
                route_confidence=confidence,
                routing_probabilities=probabilities,
                attempts=[],
                reason=(
                    "Jev requested escalation."
                    if choice == "escalate"
                    else f"Routing confidence {confidence:.3f} is below threshold {route_threshold:.3f}."
                ),
            )
            await self._record(request, response)
            return response

        by_id = {candidate.id: candidate for candidate in request.candidates}
        ranked = [
            tool_id
            for tool_id, _ in sorted(probabilities.items(), key=lambda item: item[1], reverse=True)
            if tool_id in by_id
        ]
        if choice in by_id and choice not in ranked[:1]:
            ranked.insert(0, choice)
        if not ranked and choice in by_id:
            ranked = [choice]

        attempts: list[AttemptResult] = []
        for tool_id in ranked[:max_attempts]:
            candidate = by_id[tool_id]
            try:
                output = await self.treg.execute(candidate, dry_run=request.dry_run)
            except TregError as exc:
                output = f"TREG_ERROR: {exc}"

            if output.startswith("TREG_ERROR:"):
                # Deterministic transport/provider failures need no model judgment.
                probability = 0.0
            else:
                verification_state = {
                    "objective": request.objective,
                    "success_criteria": request.success_criteria,
                    "original_state": request.state,
                    "selected_tool": candidate.model_dump(),
                    "tool_output": output[:20000],
                }
                verification = await self.jev.decide(
                    verification_state,
                    {
                        "sufficient": {
                            "type": "noul",
                            "instructions": (
                                "Judge whether tool_output provides enough trustworthy evidence to satisfy "
                                "the objective and success_criteria. Evaluate only evidence relevant to those "
                                "criteria. Exact identity/domain matches and explicit machine-verification "
                                "signals such as verified=true, valid=true, validIdentity=true, "
                                "validSMTP=true, validity=valid, or equivalent provider fields are strong "
                                "positive evidence when relevant. Do not require unrelated fields that the "
                                "success criteria did not ask for. Return low probability for errors, misses, "
                                "identity mismatches, contradictory evidence, or genuinely insufficient data."
                            ),
                            "criteria": {
                                "true": (
                                    "The requested result is directly supported by the output, relevant "
                                    "identifiers match, and any available validation evidence supports it."
                                ),
                                "false": (
                                    "The result is erroneous, missing, mismatched, contradicted, "
                                    "unverified where verification is required, or insufficient."
                                ),
                            },
                        }
                    },
                )
                probability = float(
                    verification["answers"]["sufficient"].get("noul") or 0.0
                )
            passed = probability >= verify_threshold
            attempts.append(
                AttemptResult(
                    tool_id=tool_id,
                    route_probability=float(probabilities.get(tool_id, 0.0)),
                    output=output,
                    verification_probability=probability,
                    passed=passed,
                )
            )
            if passed:
                response = RunResponse(
                    run_id=run_id,
                    status="passed",
                    selected_tool=tool_id,
                    route_confidence=confidence,
                    routing_probabilities=probabilities,
                    attempts=attempts,
                    reason=(
                        f"Tool result verified at {probability:.3f}, meeting threshold "
                        f"{verify_threshold:.3f}."
                    ),
                )
                await self._record(request, response)
                return response

        response = RunResponse(
            run_id=run_id,
            status="escalate",
            selected_tool=choice if choice in by_id else None,
            route_confidence=confidence,
            routing_probabilities=probabilities,
            attempts=attempts,
            reason="No attempted tool produced a result above the verification threshold.",
        )
        await self._record(request, response)
        return response

    async def _record(self, request: RunRequest, response: RunResponse) -> None:
        record = RunRecord(
            id=response.run_id,
            objective=request.objective,
            status=response.status,
            selected_tool=response.selected_tool,
            route_confidence=response.route_confidence,
            payload_json=request.model_dump_json(),
            result_json=response.model_dump_json(),
        )
        async with self.database.session() as session:
            session.add(record)
            await session.commit()
