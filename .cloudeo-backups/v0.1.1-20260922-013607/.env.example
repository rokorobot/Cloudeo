# Core
CLOUDEO_HOST=127.0.0.1
CLOUDEO_PORT=18800
CLOUDEO_DATABASE_URL=sqlite+aiosqlite:///./cloudeo.db

# Jev backend: mock | openrouter
CLOUDEO_JEV_BACKEND=mock
OPENROUTER_API_KEY=
CLOUDEO_JEV_MODEL=typesafe/jev-1.13
CLOUDEO_JEV_URL=https://openrouter.ai/api/alpha/decisions

# Treg backend: mock | cli
CLOUDEO_TREG_BACKEND=mock
# If set, Cloudeo runs: uv run --project <path> treg ...
# Example: /home/robert/treg or /mnt/c/Users/Robert/treg
CLOUDEO_TREG_REPO=
CLOUDEO_TREG_TIMEOUT_SECONDS=60

# Policy defaults
CLOUDEO_ROUTE_CONFIDENCE=0.65
CLOUDEO_VERIFY_PROBABILITY=0.85
CLOUDEO_MAX_ATTEMPTS=2
